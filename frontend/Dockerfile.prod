# Build de produção do frontend: assets estáticos servidos por nginx (leve),
# em vez do dev server do Vite usado em docker-compose.yml (dev local).
# Contexto de build esperado: raiz do repositório (ver infra/vps/docker-compose.yml),
# para poder copiar infra/vps/meupredio-nginx.conf abaixo.

FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ .

# Path onde o app fica atrás do gateway compartilhado da VPS, e URL (relativa,
# mesma origem) onde a API responde nesse mesmo path — ver infra/vps/README.md.
ARG VITE_BASE_PATH=/meupredio/
ARG VITE_API_URL=/meupredio
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/vps/meupredio-nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
