# =============================================================================
# MeuPredio - variáveis de ambiente (exemplo)
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# NUNCA commite o arquivo ".env" real (já está no .gitignore).
# =============================================================================

# --- PostgreSQL (serviço "db" no docker-compose) ---
POSTGRES_USER=meupredio
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=meupredio
# Banco separado usado pela suíte de testes do backend (criado automaticamente
# pelo script em docker/postgres-init/ na primeira subida do container).
POSTGRES_DB_TEST=meupredio_test
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# String de conexão usada pela aplicação. Dentro do docker-compose o host é
# "db"; rodando o backend fora do Docker, use "localhost".
DATABASE_URL=postgresql+psycopg://meupredio:troque-esta-senha-local@db:5432/meupredio
DATABASE_URL_TEST=postgresql+psycopg://meupredio:troque-esta-senha-local@db:5432/meupredio_test

# Chave secreta usada para assinar os JWTs de autenticação.
# GERE UM VALOR ÚNICO E ALEATÓRIO POR AMBIENTE, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA reutilize o valor de exemplo abaixo em produção.
SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-de-64-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens permitidas para CORS (separadas por vírgula).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ambiente da aplicação: development | test | production
ENVIRONMENT=development

# --- Bootstrap do primeiro usuário Administrador (app/scripts/seed_admin.py) ---
# Usado apenas uma vez para criar o admin inicial de forma idempotente.
FIRST_ADMIN_EMAIL=admin@meupredio.local
FIRST_ADMIN_PASSWORD=troque-esta-senha-tambem
FIRST_ADMIN_FULL_NAME=Administrador MeuPredio

# --- Frontend (Vite) ---
# URL base da API consumida pelo frontend em desenvolvimento.
VITE_API_URL=http://localhost:8000
